	keywords = {Cooling, Electronic packaging thermal management, Heat sinks, Microchannels, Multichip modules, Power electronics, Resistance, Resistance heating, Silicon carbide, Thermal resistance, power density, power modules, silicon carbide (SiC), thermal management, ultrahigh heat flux},
	pages = {2125--2137},
}

