	keywords = {Heat sinks, High-voltage direct current (HVdc) cooling, Insulated gate bipolar transistors, Magnetohydrodynamics, Metals, Packaging, Water heating, junction temperature, liquid metal cooling, magnetohydrodynamic (MHD) pump, press-pack insulated-gate bipolar transistor (IGBT) power module cooling},
	pages = {1849--1860},
}

