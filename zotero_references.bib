@article{hodes_potential_2014,
	title = {On the {Potential} of {Galinstan}-{Based} {Minichannel} and {Minigap} {Cooling}},
	volume = {4},
	issn = {2156-3985},
	url = {https://ieeexplore.ieee.org/abstract/document/6612637},
	doi = {10.1109/TCPMT.2013.2274699},
	abstract = {Galinstan, a gallium, indium, and tin eutectic, may be exploited for enhanced cooling of microelectronics because of its favorable thermophysical properties. A careful evaluation of its cooling potential, however, has not been undertaken. Provided here is a first-order model to compute the total (i.e., caloric plus conjugate conduction and convection) thermal resistance of galinstan-based heat sinks. Geometrically optimized minichannel heat sinks with rectangular channels for surface area enhancement and minigap, i.e., single parallel-plate channel, heat sinks are considered. Direct liquid cooling of a microprocessor die is envisioned. Therefore, the flow channels within the heat sinks are 302- μm tall, the pressure drop prescribed across them is 214 kPa, and their streamwise length is varied from 5 to 20 mm. The calculations suggest that galinstan is a better coolant than water in such configurations, reducing thermal resistance by about 40\%.},
	number = {1},
	urldate = {2026-03-21},
	journal = {IEEE Transactions on Components, Packaging and Manufacturing Technology},
	author = {Hodes, Marc and Zhang, Rui and Lam, Lisa Steigerwalt and Wilcoxon, Ross and Lower, Nate},
	month = jan,
	year = {2014},
	keywords = {Galinstan, Heat sinks, Heat transfer, Metals, Resistance heating, Thermal resistance, microchannel heat sink, minichannel heat sink, thermal management of electronics},
	pages = {46--56},
}

