@article{hart_magnetohydrodynamically_2025,
	title = {Magnetohydrodynamically pumped liquid metal loops for {CubeSat} thermal control},
	volume = {239},
	issn = {0017-9310},
	url = {https://www.sciencedirect.com/science/article/pii/S0017931024013802},
	doi = {10.1016/j.ijheatmasstransfer.2024.126552},
	abstract = {There are few heat transport technologies available for use on high-power SmallSats and CubeSats, and many of them are ill-suited to their inherently small form factor and large heat loads. As electric propulsion, high-data-rate communications, and other high-power technologies gain prominence, thermal management is expected to become a design bottleneck. This work proposes a heat transfer loop consisting of a magnetohydrodynamic (MHD) pump and a liquid metal working fluid. The MHD pump leverages the Lorentz force to drive the liquid without the use of moving parts, which contributes to a low probability of failure. The MHD loop also overcomes many of the practical challenges associated with conventional technologies, such as routing, handling of multiple heat sources, and high heat flux management. Analytical performance models of the MHD cooling loop are developed and validated against test data collected from prototype systems using gallium. Test results indicate flow rates up to 6.1 ml/s, corresponding to a maximum heat transfer rate of 13.8 W/K with a total system mass of 98 g. These performance metrics surpass the capabilities of state-of-the-art mechanically pumped loops. Electrical compatibility with standard CubeSats buses is achieved using a small power processing unit, which allows for high-flow-rate operation of the MHD loop while complying with the PC104 standard for power buses.},
	urldate = {2026-02-06},
	journal = {International Journal of Heat and Mass Transfer},
	author = {Hart, Samuel T. and Awald, Conner and Lightsey, E. Glenn and Romero-Calvo, Álvaro},
	month = apr,
	year = {2025},
	keywords = {Cooling Loop, CubeSat, Heat transfer, Liquid Metal, MHD, Magnetohydrodynamic, SmallSat},
	pages = {126552},
}

