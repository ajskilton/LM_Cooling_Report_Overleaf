@article{fan_novel_2025,
	title = {A novel design of pump-cooler for advanced electronic cooling},
	volume = {58},
	issn = {24519049},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2451904925000174},
	doi = {10.1016/j.tsep.2025.103227},
	abstract = {The development of electronic devices raises the risk of failure due to the high heat generation rate, thus demanding advanced liquid cooling techniques. However, traditional passive approaches of heat transfer enhancement for electronics cooling are limited to modifications of surface structure, and the coolant remains laminar with significant pressure loss. The present study proposes a novel design named the “pump-cooler”, which introduces an unsteady rotatory flow rather than conventional channel flow or impingement jet and achieves turbulent heat transfer without extra pressure loss by integrating the centrifugal pump and the water block into a single unit. Numerical simulations are conducted to elucidate flow features governing the heat transfer behavior, and experiments are carried out to validate the remarkable improvement in thermal performance. The mechanism dominating the heat transfer enhancement is the transient evolution of turbulent rotatory flow driven by impeller blades. The directional flow diversion caused by the addition of surface pin-fins uniformizes the radially increasing Nusselt number at the heated surface. The thermal performance improvement by the pump-cooler is more than 80\% compared to channel flow and impingement jet with the same heat sink.},
	language = {en},
	urldate = {2026-07-20},
	journal = {Thermal Science and Engineering Progress},
	author = {Fan, Weihan and Jiang, Hongmei and Zhang, Yuze and Zhang, Qiang and Wang, Zhaoguang},
	month = feb,
	year = {2025},
	pages = {103227},
}

@article{kong_enhancing_2024,
	title = {Enhancing data center cooling efficiency and ability: {A} comprehensive review of direct liquid cooling technologies},
	volume = {308},
	issn = {0360-5442},
	shorttitle = {Enhancing data center cooling efficiency and ability},
	url = {https://www.sciencedirect.com/science/article/pii/S0360544224026203},
	doi = {10.1016/j.energy.2024.132846},
	abstract = {As data centers increasingly become the backbone of the digital age, managing their substantial energy consumption and mitigating heat generation are paramount. This paper focuses on direct liquid cooling as a transformative technology for enhancing energy efficiency and operational safety in high-density computing environments. Significant advancements and persisting challenges in this field have been identified by analyzing various direct liquid cooling methodologies including immersion, spray/jet, and microchannel cooling. Comparative analysis of these systems reveals their potential to substantially lower thermal resistances and improve energy utilization. Despite these advancements, the research highlights persistent challenges such as integration complexities and scalability issues. Recommendations for future research directions to improve the efficiency and ability of direct liquid cooling applications in data centers were concluded, emphasizing the need for user-friendly and cost-effective solutions, comprehensive guidelines for cooling method selection, and hybrid cooling systems. It also recommends advanced energy management strategies such as real-time power adjustment that dynamically matches energy supply with computational demand to optimize efficiency. These contributions underscore the importance of advancing data center cooling technologies to meet future demands.},
	urldate = {2026-04-24},
	journal = {Energy},
	author = {Kong, Rui and Zhang, Hainan and Tang, Mingsheng and Zou, Huiming and Tian, Changqing and Ding, Tao},
	month = nov,
	year = {2024},
	keywords = {Data center, Direct liquid cooling, Direct microchannel liquid cooling, Immersion cooling, Spray cooling},
	pages = {132846},
}

