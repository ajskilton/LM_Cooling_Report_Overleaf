@inproceedings{liu_art_nodate,
	title = {Art and {Science} {Towards} {Noiseless} {Driving} of {Liquid} {Metal} for {Advanced} {Thermal} {Management} of {High} {Heat} {Flux} {Device}},
	url = {https://dx.doi.org/10.1115/IPACK2015-48698},
	doi = {10.1115/IPACK2015-48698},
	abstract = {The room temperature liquid metal cooling is quickly emerging as a powerful way for the thermal management in many advanced high heat flux devices, spanning from electronics, optoelectronics, battery, to power system etc. Except for its pretty high conductivity that a metal coolant could offer, the unique merit lying behind this new generation cooling strategy is its drivability of the highly conductive coolant through the electromagnetic effect where no moving elements are involved and thus only very few energy consumption is needed. In addition, even waste heat could be strong enough to generate applicable electricity for such flow driving purpose. More directly, the temperature gradient intrinsically generated between the heat source and the sink has also been managed to drive the flow of the coolant and realize an automatic practical enough cooling in some situations. All these practices lead to a totally noiseless pumping of the heat delivery and a compact and reliable cooling modular can thus be possible. Starting from this basic point, we are dedicated here to present an overview on the art and science in developing the technical strategies for a smart driving of the liquid metal cooling of the target devices. Designing philosophy for an innovated thermal management will be discussed. Particularly, electromagnetic pumping, waste thermoelectricity driving, thermosyphon flow effect, etc. will be comparatively evaluated with each of the working performances interpreted. Power consumption rate and efficiency will be quantitatively digested. Typical application examples in the cooling of a series of device areas will be illustrated. Further improvement on the cooling solution along this category will be suggested. Challenging issues in pushing the new technology into large scale utilization will be raised. It is expected that such silent self-driving of the liquid metal coolant will find unique and important values in a wide variety of thermal management areas where reliability, compactness, low noise and energy saving are urgently requested.},
	language = {en},
	urldate = {2026-08-18},
	author = {Liu, Jing and Deng, Zhong-Shan and He, Zhi-Zhu},
}

@article{yang_dual-channel_2025,
	title = {Dual-channel electromagnetic pump with current reutilization for advanced liquid metal cooling applications},
	volume = {281},
	issn = {1359-4311},
	url = {https://www.sciencedirect.com/science/article/pii/S1359431125032491},
	doi = {10.1016/j.applthermaleng.2025.128657},
	abstract = {To address the issue of system efficiency degradation in DC conduction electromagnetic pumps (DC-EMPs) under high-current operation this study proposes a novel approach involving the extension of the current-carrying fluid path to enable secondary utilization of the driving current. A Parallel Dual-channel DC Conduction Electromagnetic Pump (PD-EMP) is developed accordingly. This structure extends the effective current-carrying length through a series-connected current design within the dual channels. An E-shaped yoke configuration establishes opposing magnetic fields (±z-direction) in the two channels ensuring co-directional Lorentz force driving of the liquid metal. Experimental results demonstrate that the PD-EMP achieves a maximum flow rate of 0.86 L/min at 40 A representing improvements of 62.3 \% and 28.4 \% compared to the conventional pump and yoke-optimized single pump respectively. Its operating flow range broadens to 0.28–1.05 L/min with efficiency exceeding 8 \% in the main flow region. For thermal control performance the driving current required to maintain the heatsink temperature rise ΔTs {\textless} 55 °C is reduced by 13.8 A compared to the yoke-optimized single pump. At the same driving current its heat flux density handling capability increases by 9.8 \% validating the PD-EMP’s ability to simultaneously reduce operating current and enhance heat dissipation. Nevertheless magnetic attenuation and larger pump volume prevent the PD-EMP from achieving twice the performance of yoke-optimized pumps. Multi-objective optimization will address this limitation.},
	urldate = {2026-08-18},
	journal = {Applied Thermal Engineering},
	author = {Yang, Jin and Chen, Guanci and Zhang, Wenbin},
	month = dec,
	year = {2025},
	keywords = {Electromagnetic pump, Heat transportation, Liquid metal, Magnetic yoke},
	pages = {128657},
}

