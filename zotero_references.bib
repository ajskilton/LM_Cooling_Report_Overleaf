	keywords = {Heat sinks, Insulated-gate bipolar transistor (IGBT) power module cooling, Junctions, Magnetohydrodynamics, Metals, Multichip modules, junction temperature, liquid metal cooling, magnetohydrodynamic (MHD) pump, reliability},
	pages = {10583--10593},
}

