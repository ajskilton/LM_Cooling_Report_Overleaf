@article{yilmaz_review_2013,
	title = {Review of {Battery} {Charger} {Topologies}, {Charging} {Power} {Levels}, and {Infrastructure} for {Plug}-{In} {Electric} and {Hybrid} {Vehicles}},
	volume = {28},
	issn = {1941-0107},
